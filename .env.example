# Modo de precisión: "fp32" o "int8"
# Cambiar este valor y reiniciar para benchmarkear ambos modos con RAGAS
MODEL_PRECISION=int8

# Rutas de las carpetas de modelos (relativas a la raíz del proyecto)
EMBEDDING_MODEL_DIR_FP32=modelo_onnx
EMBEDDING_MODEL_DIR_INT8=modelo_onnx_int8
RERANKER_MODEL_DIR_FP32=reranker_onnx_fp32
RERANKER_MODEL_DIR_INT8=reranker_onnx_int8

# Modelo base (sin fine-tunear) — para comparación con RAGAS
BASE_EMBEDDING_MODEL_DIR_FP32=modelo_base_onnx
BASE_EMBEDDING_MODEL_DIR_INT8=modelo_base_onnx_int8

# Longitud máxima de tokens
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_BASE_MAX_LENGTH=2048
RERANKER_MAX_LENGTH=1024

# ONNX Runtime — 0 = dejar que ORT decida automáticamente
ONNX_INTRA_OP_NUM_THREADS=0
ONNX_INTER_OP_NUM_THREADS=0

# Servidor
HOST=0.0.0.0
PORT=8001

# Batch size interno para el reranker (controla uso de memoria con listas largas)
RERANKER_BATCH_SIZE=16

# CORS — usar ["*"] solo en desarrollo; restringir en producción
# Ejemplo de producción: CORS_ORIGINS=["http://localhost:8000","https://ampara.example.com"]
CORS_ORIGINS=["*"]
