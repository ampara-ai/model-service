# Modo de precisión: "fp32" o "int8"
# Cambiar este valor y reiniciar para benchmarkear ambos modos con RAGAS
MODEL_PRECISION=int8

# Ruta base donde se guardan los modelos
# Dev: "." mantiene las carpetas de modelos en la raíz del proyecto (comportamiento actual)
# Docker: /app/models (montado como volumen — se setea automáticamente en docker-compose.yml)
MODELS_DIR=.

# Token de Hugging Face para descargar el repo privado (requerido por download_models.py)
# Nunca commitear un token real. Pasar en runtime vía --env o secrets manager.
HF_TOKEN=

# Forzar re-descarga aunque ya exista el marker (útil solo para depuración)
FORCE_DOWNLOAD=false

# Rutas de las carpetas de modelos (relativas a MODELS_DIR)
EMBEDDING_MODEL_DIR_FP32=modelo_onnx
EMBEDDING_MODEL_DIR_INT8=modelo_onnx_int8
RERANKER_MODEL_DIR_FP32=reranker_onnx_fp32
RERANKER_MODEL_DIR_INT8=reranker_onnx_int8

# Modelo base (sin fine-tunear) — para comparación con RAGAS
BASE_EMBEDDING_MODEL_DIR_FP32=modelo_base_onnx
BASE_EMBEDDING_MODEL_DIR_INT8=modelo_base_onnx_int8

# Longitud máxima de tokens
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_BASE_MAX_LENGTH=2048
RERANKER_MAX_LENGTH=1024

# ONNX Runtime — 0 = dejar que ORT decida automáticamente
# Azure VM 4 vCPUs recomendado: ONNX_INTRA_OP_NUM_THREADS=4, ONNX_INTER_OP_NUM_THREADS=1
ONNX_INTRA_OP_NUM_THREADS=0
ONNX_INTER_OP_NUM_THREADS=0

# Servidor
HOST=0.0.0.0
PORT=8001

# Nivel de log: INFO (producción) | DEBUG (loguea inputs y outputs de cada request)
LOG_LEVEL=INFO

# Workers de uvicorn — 1 es correcto para inferencia CPU-bound (modelos cargados en memoria por worker)
UVICORN_WORKERS=1

# Batch size interno para el reranker (controla uso de memoria con listas largas)
RERANKER_BATCH_SIZE=16

# CORS — usar ["*"] solo en desarrollo; restringir en producción
# Ejemplo de producción: CORS_ORIGINS=["https://ampara.example.com"]
CORS_ORIGINS=["*"]
